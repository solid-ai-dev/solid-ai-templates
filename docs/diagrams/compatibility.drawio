        <mxCell id="lg-2s" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;gradientColor=#FFFFFF;gradientDirection=north;strokeWidth=1.6;fillColor=#FFE4E6;strokeColor=#BE123C;" value="" vertex="1"><mxGeometry x="649" y="523" width="24" height="18" as="geometry" /></mxCell>
