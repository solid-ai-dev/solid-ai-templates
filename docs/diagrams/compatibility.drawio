        <mxCell id="lg-3s" parent="1" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#64748B;strokeWidth=2.0;dashed=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="897" y="532" as="sourcePoint" /><mxPoint x="937" y="532" as="targetPoint" /></mxGeometry></mxCell>
