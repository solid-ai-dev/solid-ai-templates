<mxfile host="drawio">
  <diagram id="compatibility" name="compatibility">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="560" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=26;fontColor=#0F172A;fontStyle=1;" value="What a release may change" vertex="1"><mxGeometry x="30" y="18" width="1380" height="36" as="geometry" /></mxCell>
        <mxCell id="t2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=13;fontColor=#64748B;" value="From 3.0.0 the contract a fork and a project build on is frozen; a 3.x minor only adds, and only 4.0.0 removes." vertex="1"><mxGeometry x="30" y="54" width="1380" height="24" as="geometry" /></mxCell>
        <mxCell id="g1" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontFamily=Segoe UI;fontSize=14;fontColor=#334155;fontStyle=1;" value="Releases" vertex="1"><mxGeometry x="30" y="100" width="1380" height="200" as="geometry" /></mxCell>
        <mxCell id="r0" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#475569;strokeWidth=1.6;shadow=1;align=center;fontFamily=Segoe UI;fontColor=#0F172A;spacing=6;" value="&lt;b style=&#x27;font-size:14px;color:#0F172A&#x27;&gt;2.90.0&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#475569&#x27;&gt;the final 2.x, with no further fixes&lt;br&gt;a project&#x27;s pin until it migrates&lt;/span&gt;" vertex="1"><mxGeometry x="60" y="160" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="r1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#B45309;strokeWidth=1.6;shadow=1;align=center;fontFamily=Segoe UI;fontColor=#0F172A;spacing=6;" value="&lt;b style=&#x27;font-size:14px;color:#0F172A&#x27;&gt;3.0.0&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#92400E&#x27;&gt;freezes paths, IDs, the manifest schema,&lt;br&gt;the declaration block, core membership&lt;br&gt;and check exit codes&lt;/span&gt;" vertex="1"><mxGeometry x="420" y="160" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#B45309;strokeWidth=1.6;shadow=1;align=center;fontFamily=Segoe UI;fontColor=#0F172A;spacing=6;" value="&lt;b style=&#x27;font-size:14px;color:#0F172A&#x27;&gt;3.x minor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#92400E&#x27;&gt;adds templates, sections, IDs and fields&lt;br&gt;may mark an element deprecated,&lt;br&gt;naming its replacement&lt;/span&gt;" vertex="1"><mxGeometry x="780" y="160" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="r3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#B45309;strokeWidth=1.6;shadow=1;align=center;fontFamily=Segoe UI;fontColor=#0F172A;spacing=6;" value="&lt;b style=&#x27;font-size:14px;color:#0F172A&#x27;&gt;4.0.0&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#92400E&#x27;&gt;removes what 3.x deprecated&lt;br&gt;the next major freezes again&lt;/span&gt;" vertex="1"><mxGeometry x="1140" y="160" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="e1" parent="1" source="r0" target="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;jettySize=auto;strokeColor=#64748B;strokeWidth=2.0;endArrow=blockThin;endFill=1;endSize=5;fontFamily=Segoe UI;fontSize=11;fontColor=#475569;fontStyle=1;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="migrate" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" source="r1" target="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;jettySize=auto;strokeColor=#64748B;strokeWidth=2.0;endArrow=blockThin;endFill=1;endSize=5;fontFamily=Segoe UI;fontSize=11;fontColor=#475569;fontStyle=1;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="additive" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" parent="1" source="r2" target="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;jettySize=auto;strokeColor=#64748B;strokeWidth=2.0;endArrow=blockThin;endFill=1;endSize=5;fontFamily=Segoe UI;fontSize=11;fontColor=#475569;fontStyle=1;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="removal" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontFamily=Segoe UI;fontSize=14;fontColor=#334155;fontStyle=1;" value="The one exception" vertex="1"><mxGeometry x="30" y="320" width="1380" height="140" as="geometry" /></mxCell>
        <mxCell id="s" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE4E6;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#BE123C;strokeWidth=1.6;shadow=1;align=center;fontFamily=Segoe UI;fontColor=#0F172A;spacing=6;" value="&lt;b style=&#x27;font-size:14px;color:#0F172A&#x27;&gt;A security fix&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#9F1239&#x27;&gt;may change or remove a frozen element&lt;br&gt;in a minor, under Breaking changes&lt;/span&gt;" vertex="1"><mxGeometry x="780" y="370" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="e4" parent="1" source="s" target="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;jettySize=auto;strokeColor=#64748B;strokeWidth=2.0;endArrow=blockThin;endFill=1;endSize=5;fontFamily=Segoe UI;fontSize=11;fontColor=#475569;fontStyle=1;labelBackgroundColor=#F8FAFC;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value="breaks early" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=12;fontColor=#475569;" value="Prose inside a section changes freely in any release: the freeze covers what a fork or a project refers to, not the wording of a rule." vertex="1"><mxGeometry x="30" y="478" width="1380" height="24" as="geometry" /></mxCell>
