        <mxCell id="c1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;gradientColor=#FFFFFF;gradientDirection=north;strokeWidth=1.6;shadow=1;align=center;spacing=6;fontFamily=Segoe UI;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;" value="&lt;b style='font-size:13px;color:#0F172A'&gt;Core tier&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#92400E;font-family:Consolas'&gt;core:, then fork_core:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#92400E'&gt;seeded into every chain, never declared&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="120" width="330" height="84" as="geometry" /></mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;gradientColor=#FFFFFF;gradientDirection=north;strokeWidth=1.6;shadow=1;align=center;spacing=6;fontFamily=Segoe UI;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;" value="&lt;b style='font-size:13px;color:#0F172A'&gt;Opt-in tier&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#334155;font-family:Consolas'&gt;depends_on&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#334155'&gt;reaches a chain only when a stack names it&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="240" width="330" height="84" as="geometry" /></mxCell>
